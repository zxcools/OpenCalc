# ===== 本地数据与配置（含个人交易记录，勿上传）=====
data/
config.json
*.opcalc

# ===== 打包中间产物（每次打包自动生成）=====
build/
build_old*/
build_tmp*/
__pycache__/
*.pyc

# ===== 历史版本备份（保留本地即可）=====
backup/
archive/

# ===== 本地工作记忆 =====
.workbuddy/

# ===== 测试临时产物 =====
.e2e-chrome*/
.e2e-data*/
_tmp_*
.tmp_*/

# 运行中实例被改名后的残留(不能删, 进程还开着)
dist/*_running.exe

# 打包时的版本化 spec(标准名 OpenCalc.spec 保留)
OpenCalc_v*.spec

# 界面验证截图(临时)
_shot_*.png
_logo_*.png
_verify_*.js
_tmp/_*.py
/_*.js
/_probe*
/_*.py
/_*.js
/_probe*
design/icon/_*.png

# ===== 系统文件 =====
Thumbs.db
.DS_Store
Desktop.ini

# design 下的图标生成器是有意保留的, 不被上面的规则忽略
!design/icon/_*.py
